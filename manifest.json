{
  "manifestVersion": 5,
  "id": "com.lassodraw.photoshop",
  "name": "lassoDraw",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lassoDraw",
      "label": {
        "default": "lassoDraw"
      },
      "minimumSize": { "width": 220, "height": 200 },
      "maximumSize": { "width": 1200, "height": 1200 },
      "preferredDockedSize": { "width": 260, "height": 380 },
      "preferredFloatingSize": { "width": 300, "height": 420 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
