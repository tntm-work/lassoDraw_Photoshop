{
  "manifestVersion": 5,
  "id": "com.lassodraw.photoshop",
  "name": "lassoDraw",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lassoDraw",
      "label": {
        "default": "lassoDraw"
      },
      "minimumSize": { "width": 180, "height": 140 },
      "maximumSize": { "width": 1200, "height": 1200 },
      "preferredDockedSize": { "width": 210, "height": 290 },
      "preferredFloatingSize": { "width": 230, "height": 310 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
